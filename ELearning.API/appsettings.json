{
  "Ocelot": {
    "Enabled": false
  },
  "Database": {
    "Provider": "SqliteInMemory",
    "SqliteInMemoryConnection": "Data Source=:memory:;Cache=Shared"
  },
  "Observability": {
    "ServiceName": "elearning-api",
    "ConsoleExporterEnabled": false,
    "OtlpEndpoint": null
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "elearning.integration.events",
    "PublisherConfirmTimeoutSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
